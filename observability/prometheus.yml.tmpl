global:
  scrape_interval: ${PMC_PROM_SCRAPE_INTERVAL}

scrape_configs:
  - job_name: "pmc_single"
    static_configs:
      - targets:
          - "${PMC_PROM_TARGET_1}"
          - "${PMC_PROM_TARGET_2}"

  - job_name: "pmc_cluster"
    http_sd_configs:
      - url: "${PMC_PROM_DISCOVERY_URL}"
        refresh_interval: ${PMC_PROM_DISCOVERY_REFRESH_INTERVAL}
