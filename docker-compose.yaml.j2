services:
  cache:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        - BUILD_TYPE=Release
    extends:
      file: common-compose-config.yaml
      service: cache-common
    profiles:
      - main
    networks:
      - cache_network
    ports:
      - "9001:9001"
      - "8080:8080"

  cache-cluster:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        - BUILD_TYPE=Release
    extends:
      file: common-compose-config.yaml
      service: cache-common
    entrypoint: ["/app/pmc-cluster-launcher"]
    command: ["/app/poor-man-s-cache", "${CLUSTER_WORKERS:-8}", "${CLUSTER_BASE_PORT:-9001}"]
    environment:
      - CLUSTER_WORKERS=${CLUSTER_WORKERS:-8}
      - CLUSTER_BASE_PORT=${CLUSTER_BASE_PORT:-9001}
    profiles:
      - cluster
    networks:
      - cache_network
    ports: []

{% for i in range(1, num_tests + 1) %}
  tests-{{ i }}:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
    command: ["tcp_server_test.py"]
    profiles:
      - tests
    networks:
      - cache_network
{% endfor %}

  client-integration:
    build:
      context: .
      dockerfile: tests/client_integration/Dockerfile
    environment:
      - CACHE_HOST=cache
      - CACHE_PORT=9001
    profiles:
      - client-tests
    networks:
      - cache_network

  tests-pipelined:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
    profiles:
      - tests-pipelined
    networks:
      - cache_network
    command: ["tcp_server_test.py", "-p", "-b", "128"]

  tests-resp:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
      - CACHE_TYPE=resp
    profiles:
      - tests-resp
    networks:
      - cache_network
    command: ["tcp_server_test.py", "--resp"]

  tests-resp-pipelined:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
      - CACHE_TYPE=resp
    profiles:
      - tests-resp-pipelined
    networks:
      - cache_network
    command: ["tcp_server_test.py", "--resp", "-p", "-b", "128"]

  tests-req-per-conn:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
      - SOCKET_TIMEOUT_SEC=30
      - TEST_ITERATIONS=10000
    profiles:
      - tests-req-per-conn
    networks:
      - cache_network
    command: ["per_request_connection_test.py"]

  tests-cluster:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache-cluster
      - CLUSTER_BASE_PORT=${CLUSTER_BASE_PORT:-9001}
      - TEST_ITERATIONS=${PMC_CLUSTER_TEST_ITERATIONS:-1000000}
    profiles:
      - tests-cluster
    networks:
      - cache_network
    command: ["tcp_server_cluster_test.py", "-p", "-b", "256"]

networks:
  cache_network:
    driver: bridge
