services:
  cache:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        - BUILD_TYPE=Release
    extends:
      file: common-compose-config.yaml
      service: cache-common
    profiles:
      - main
    networks:
      - cache_network
    ports:
      - "9001:9001"
      - "9100:9100"

  cache-cluster:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        - BUILD_TYPE=Release
    extends:
      file: common-compose-config.yaml
      service: cache-common
    entrypoint: ["/app/pmc-cluster-controller"]
    command: ["/app/poor-man-s-cache", "${CLUSTER_WORKERS:-8}", "${CLUSTER_BASE_PORT:-9001}"]
    environment:
      - CLUSTER_WORKERS=${CLUSTER_WORKERS:-8}
      - CLUSTER_BASE_PORT=${CLUSTER_BASE_PORT:-9001}
    profiles:
      - cluster
    networks:
      - cache_network
    ports: []
    expose:
      - "9400"

  prometheus:
    image: prom/prometheus:latest
    profiles:
      - monitoring
    environment:
      - PMC_PROM_SCRAPE_INTERVAL=${PMC_PROM_SCRAPE_INTERVAL:-5s}
      - PMC_PROM_DISCOVERY_REFRESH_INTERVAL=${PMC_PROM_DISCOVERY_REFRESH_INTERVAL:-5s}
      - PMC_PROM_TARGET_1=${PMC_PROM_TARGET_1:-cache:9100}
      - PMC_PROM_TARGET_2=${PMC_PROM_TARGET_2:-host.docker.internal:9100}
      - PMC_PROM_DISCOVERY_URL=${PMC_PROM_DISCOVERY_URL:-http://cache-cluster:9400/discovery}
    entrypoint:
      - /bin/sh
      - -ec
    command: >-
      sed -e "s|$${PMC_PROM_SCRAPE_INTERVAL}|$$PMC_PROM_SCRAPE_INTERVAL|g" -e "s|$${PMC_PROM_DISCOVERY_REFRESH_INTERVAL}|$$PMC_PROM_DISCOVERY_REFRESH_INTERVAL|g" -e "s|$${PMC_PROM_TARGET_1}|$$PMC_PROM_TARGET_1|g" -e "s|$${PMC_PROM_TARGET_2}|$$PMC_PROM_TARGET_2|g" -e "s|$${PMC_PROM_DISCOVERY_URL}|$$PMC_PROM_DISCOVERY_URL|g" /etc/prometheus/prometheus.yml.tmpl > /etc/prometheus/prometheus.yml && exec /bin/prometheus --config.file=/etc/prometheus/prometheus.yml
    volumes:
      - ./observability/prometheus.yml.tmpl:/etc/prometheus/prometheus.yml.tmpl:ro
    ports:
      - "9090:9090"
    networks:
      - cache_network

  grafana:
    image: grafana/grafana-oss:latest
    profiles:
      - monitoring
    environment:
      - GF_PATHS_PROVISIONING=/etc/grafana/provisioning
      - PMC_GRAFANA_PROMETHEUS_URL=${PMC_GRAFANA_PROMETHEUS_URL:-http://prometheus:9090}
    ports:
      - "3000:3000"
    volumes:
      - ./observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./observability/grafana:/var/lib/grafana/dashboards:ro
    depends_on:
      - prometheus
    networks:
      - cache_network

{% for i in range(1, num_tests + 1) %}
  tests-{{ i }}:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
    command: ["tcp_server_test.py"]
    profiles:
      - tests
    networks:
      - cache_network
{% endfor %}

  client-integration:
    build:
      context: .
      dockerfile: tests/client_integration/Dockerfile
    environment:
      - CACHE_HOST=cache
      - CACHE_PORT=9001
    profiles:
      - client-tests
    networks:
      - cache_network

  tests-pipelined:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
    profiles:
      - tests-pipelined
    networks:
      - cache_network
    command: ["tcp_server_test.py", "-p", "-b", "128"]

  tests-resp:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
      - CACHE_TYPE=resp
    profiles:
      - tests-resp
    networks:
      - cache_network
    command: ["tcp_server_test.py", "--resp"]

  tests-resp-pipelined:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
      - CACHE_TYPE=resp
    profiles:
      - tests-resp-pipelined
    networks:
      - cache_network
    command: ["tcp_server_test.py", "--resp", "-p", "-b", "128"]

  tests-req-per-conn:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache
      - SOCKET_TIMEOUT_SEC=30
      - TEST_ITERATIONS=10000
    profiles:
      - tests-req-per-conn
    networks:
      - cache_network
    command: ["per_request_connection_test.py"]

  tests-cluster:
    extends:
      file: common-compose-config.yaml
      service: tests-common
    environment:
      - CACHE_HOST=cache-cluster
      - CLUSTER_BASE_PORT=${CLUSTER_BASE_PORT:-9001}
      - TEST_ITERATIONS=${PMC_CLUSTER_TEST_ITERATIONS:-1000000}
    profiles:
      - tests-cluster
    networks:
      - cache_network
    command: ["tcp_server_cluster_test.py", "-p", "-b", "256"]

networks:
  cache_network:
    driver: bridge
